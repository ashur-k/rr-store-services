
# Public domain
DOMAIN=rr-store.co.uk

# PostgreSQL bootstrap account
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Separate application database passwords
USER_SERVICE_DB_PASSWORD=CHANGE_ME
STORE_SERVICE_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# Django
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=rr-store.co.uk,www.rr-store.co.uk,user-service
DJANGO_CSRF_TRUSTED_ORIGINS=https://rr-store.co.uk,https://www.rr-store.co.uk

# Keycloak realm and user-service clients
KC_REALM=rr-store
KC_SERVER_URL=http://keycloak:8080
KC_BROWSER_SERVER_URL=https://rr-store.co.uk

OIDC_RP_CLIENT_ID=user-service
OIDC_RP_CLIENT_SECRET=CHANGE_ME

KC_ADMIN_CLIENT_ID=user-service-admin
KC_ADMIN_CLIENT_SECRET=CHANGE_ME

# Store-service machine-to-machine authentication
STORE_SERVICE_M2M_CLIENT_ID=user-service-store-check
STORE_SERVICE_M2M_CLIENT_SECRET=CHANGE_ME

# RabbitMQ
RABBITMQ_DEFAULT_USER=rr_store_app
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rr_store_app
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/

# FastAPI database connection
DATABASE_URL=postgresql+asyncpg://store_service:CHANGE_ME@postgres:5432/store-service

# FastAPI Keycloak settings
KC_AUDIENCE=account
KC_M2M_AUDIENCE=store-service
KC_M2M_CLIENT_ID=user-service-store-check

# Keycloak database connection
KC_DB_USERNAME=keycloak

# Keycloak bootstrap administrator
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
